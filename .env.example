# Copy to .env (git-ignored) and fill in. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-0731
# USD per million tokens, from the model card (deepseek-v4-flash-0731: in 0.04, out 0.08).
# Context window: 1.3M tokens. Cutover's tier caps (dispatch.yaml) stay far below it on purpose.
DEEPSEEK_PRICE_INPUT_PER_M=0.04
DEEPSEEK_PRICE_OUTPUT_PER_M=0.08
