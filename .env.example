# Copy to .env (git-ignored) and fill in. Never commit real keys.
DEEPSEEK_API_KEY=
# api.deepseek.com accepts deepseek-flash and deepseek-v4-pro (GET /models); it rejects
# deepseek-v4-flash-0731. These are reasoning models: reasoning tokens count as output.
DEEPSEEK_MODEL=deepseek-flash
# USD per million tokens, from the model card (in 0.04, out 0.08). Confirm they match the model you call.
# Context window: 1.3M tokens. Cutover's tier caps (dispatch.yaml) stay far below it on purpose.
DEEPSEEK_PRICE_INPUT_PER_M=0.04
DEEPSEEK_PRICE_OUTPUT_PER_M=0.08
